#include <stdio.h>

int main() {
    int s = 0;
    for (int i = 0; i < 10; i++) {
        if (i == 3) { continue; }
        if (i == 7) { break; }
        s += i;
    }
    int j = 0;
    while (1) {
        j++;
        if (j >= 4) { break; }
    }
    int k = 0;
    do {
        k++;
        if (k == 2) { continue; }
    } while (k < 5);
    printf("%d %d %d\n", s, j, k);
    return 0;
}